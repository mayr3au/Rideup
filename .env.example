# Copier en .env.local (en local) et renseigner les mêmes variables dans Vercel.

# URL publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase : Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe : Developers → API keys, puis Product catalog (deux prix mensuels)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PROGRESS=price_...   # 14,99 €/mois
STRIPE_PRICE_ELITE=price_...      # 29,99 €/mois

# Anthropic : console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-...
# Un modèle par tâche (valeurs par défaut ci-dessous, à ne renseigner que pour changer).
# Les tarifs sont connus du code (src/lib/ai.ts) : le suivi des dépenses de l'admin est exact.
# AI_MODEL_ANALYSE=claude-sonnet-5-5
# AI_EFFORT_ANALYSE=medium        # low | medium | high
# AI_MODEL_COACH=claude-haiku-5-5
# AI_EFFORT_COACH=medium
# AI_MODEL_PROGRAMME=claude-sonnet-5-5

# Météo : Open-Meteo est gratuit en non commercial. Pour un site payant, prendre une clé
# sur open-meteo.com/en/pricing (laisser vide pendant les tests).
OPEN_METEO_API_KEY=

# Alertes vent (Elite) : e-mails via resend.com
RESEND_API_KEY=
EMAIL_FROM="RIDE'UP <alertes@ton-domaine.fr>"
# Protège la tâche planifiée /api/cron/wind-alerts (chaîne aléatoire longue)
CRON_SECRET=
